# Copy to .env and fill in. Never commit .env.

# --- Ring -------------------------------------------------------------------------------
# Developer Playground token (~30 min). Optional: you can also paste it in the dashboard.
RING_ACCESS_TOKEN=
# From your app in the Ring Developer Portal (shown once at app creation).
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_HMAC_KEY=

# --- AWS --------------------------------------------------------------------------------
AWS_REGION=us-east-1
# Turn on to use Amazon Bedrock for the vision check and the daily brief.
BEDROCK_ENABLED=0
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# Optional Bedrock Guardrail applied to the vision call.
BEDROCK_GUARDRAIL_ID=
# Optional SNS topic for SMS/email alerts.
SNS_TOPIC_ARN=

# --- App --------------------------------------------------------------------------------
# 1 = virtual clock + "Play the day" scenario. 0 = real clock, production behaviour.
TURNOVER_DEMO=1
PUBLIC_BASE_URL=http://localhost:8000
HOST_EMAIL=host@example.com
HOST_PASSWORD=change-me
