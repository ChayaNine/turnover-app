index 0000000..bb282b8
--- /dev/null
+++ b/lib/webhook-signature.ts
@@ -0,0 +1,35 @@
+import { createHmac, timingSafeEqual } from 'crypto'
+
+/**
+ * Ring webhook signature verification.
+ *
+ * Ring signs every webhook with HMAC-SHA256 over the raw request body, using the
+ * HMAC Signing Key issued when you create your app, and sends the hex digest as
+ * `X-Signature: sha256=<hex>`. See "Webhook Authentication & Verification" in
+ * https://developer.amazon.com/docs/ring/api-documentation.html#notifications
+ *
+ * Verify the exact bytes you received, before parsing: re-serialising the JSON
+ * produces different bytes and the digest will not match.
+ *
+ * The same key is used for account-linking nonces, but nonces are URL-safe
+ * Base64 without padding, while webhook signatures are hex. Don't mix them up.
+ */
+
+export const SIGNATURE_HEADER = 'x-signature'
+
+export function signRingWebhook(rawBody: Buffer | string, signingKey: string): string {
+  return 'sha256=' + createHmac('sha256', signingKey).update(rawBody).digest('hex')
+}
+
+export function verifyRingWebhook(
+  rawBody: Buffer | string,
+  signatureHeader: string | null,
+  signingKey: string | undefined
+): boolean {
+  if (!signatureHeader || !signingKey) return false
+  const received = signatureHeader.trim().toLowerCase().replace(/^sha256=/, '')
+  const expected = createHmac('sha256', signingKey).update(rawBody).digest('hex')
+  const a = Buffer.from(received, 'utf8')
+  const b = Buffer.from(expected, 'utf8')
+  return a.length === b.length && timingSafeEqual(a, b)
+}
